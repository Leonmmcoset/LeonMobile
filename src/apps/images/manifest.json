{
  "format": 1,
  "id": "org.leon.images",
  "version": "1.0.0",
  "arch": "aarch64",
  "entry": "/usr/bin/leon-images",
  "name": "图片",
  "name_en": "Images",
  "lmui": 1,
  "icon": "images",
  "lifecycle": 1,
  "handlers": [
    {
      "action": "open",
      "mime": "image/png"
    },
    {
      "action": "open",
      "mime": "image/jpeg"
    },
    {
      "action": "share",
      "mime": "image/png"
    },
    {
      "action": "share",
      "mime": "image/jpeg"
    }
  ],
  "permissions": [
    "files.import"
  ]
}
