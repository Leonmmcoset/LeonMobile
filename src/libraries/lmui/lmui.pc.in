prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: LMUI
Description: LeonMobile native Material-style mobile UI framework
Version: @PROJECT_VERSION@
Requires: cairo
Requires.private: wayland-client pangocairo xkbcommon
Libs: -L${libdir} -llmui
Cflags: -I${includedir}
