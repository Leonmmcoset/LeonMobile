LIBVTERM_LEON_VERSION = 0.3.3
LIBVTERM_LEON_SOURCE = libvterm-$(LIBVTERM_LEON_VERSION).tar.gz
LIBVTERM_LEON_SITE = https://www.leonerd.org.uk/code/libvterm
LIBVTERM_LEON_LICENSE = MIT
LIBVTERM_LEON_LICENSE_FILES = LICENSE
LIBVTERM_LEON_INSTALL_STAGING = YES
LIBVTERM_LEON_DEPENDENCIES = host-libtool

define LIBVTERM_LEON_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) $(TARGET_CONFIGURE_OPTS) LIBTOOL=$(HOST_DIR)/bin/libtool PREFIX=/usr libvterm.la
endef
define LIBVTERM_LEON_INSTALL_STAGING_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) LIBTOOL=$(HOST_DIR)/bin/libtool PREFIX=/usr DESTDIR=$(STAGING_DIR) install-inc install-lib
endef
define LIBVTERM_LEON_INSTALL_TARGET_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) LIBTOOL=$(HOST_DIR)/bin/libtool PREFIX=/usr DESTDIR=$(TARGET_DIR) install-lib
endef
$(eval $(generic-package))
